{
  "name": "codex-switch-web",
  "version": "0.1.14",
  "private": true,
  "author": "Lsogod",
  "description": "Local Codex multi-account switcher with web and menu bar shells",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "web": "node server.js",
    "app": "electron .",
    "app:dir": "electron-builder --publish never --mac dir",
    "app:dmg": "electron-builder --publish never --mac dmg",
    "app:win": "electron-builder --publish never --win nsis zip",
    "app:dist": "electron-builder --publish never --mac dmg zip --win nsis zip"
  },
  "devDependencies": {
    "electron": "^41.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.lsogod.codexswitch",
    "productName": "Codex Switch",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "server.js",
      "bin/**/*",
      "public/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "artifactName": "Codex-Switch-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "artifactName": "Codex-Switch-${version}-win-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.17"
  }
}
