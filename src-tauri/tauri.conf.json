{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Switch",
  "version": "0.1.16",
  "identifier": "com.lsogod.codexswitch.windows",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../public",
    "devUrl": null
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Codex Switch",
        "width": 1360,
        "height": 920,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "overlay",
        "title": "Codex Switch Overlay",
        "url": "overlay.html",
        "width": 86,
        "height": 96,
        "minWidth": 86,
        "minHeight": 96,
        "maxWidth": 278,
        "maxHeight": 128,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../build/icon-32.png",
      "../build/icon-128.png",
      "../build/icon-256.png",
      "../build/icon.ico",
      "../build/icon.icns"
    ],
    "windows": {
      "wix": null,
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
